# ── Cricket World Cup RAG — FRONTEND environment ──────────────────────
# Local:  you do NOT need this file. `python app.py` writes js/config.js
#         pointing at your local backend automatically.
# Vercel: set API_BASE_URL in Project → Settings → Environment Variables.
#
# build.mjs reads API_BASE_URL and bakes it into js/config.js at build time.
# There are no secrets here — anything in this file ships to the browser.

# Base URL of the deployed backend API on Render (no trailing slash).
API_BASE_URL=https://cricket-world-cup-rag-assistant-backend.onrender.com

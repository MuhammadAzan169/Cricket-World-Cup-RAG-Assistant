# ──────────────────────────────────────────────────────────────────────
# Cricket World Cup RAG Assistant — BACKEND environment variables
# ──────────────────────────────────────────────────────────────────────
# Local:  cp .env.example .env   and fill in your key(s).
# Render: set these in Dashboard → Service → Environment (never commit .env).
# ──────────────────────────────────────────────────────────────────────

# ── Environment mode ──────────────────────────────────────────────────
# local  = full functionality, heavier local models allowed (cross-encoder).
# render = lightweight, API-based only, fits in the 512MB free plan.
# Leave unset to auto-detect (Render sets RENDER=true, so it picks "render";
# everywhere else defaults to "local").
APP_ENV=local

# ── LLM provider (OpenAI-compatible endpoint) ─────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-oss-20b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── API key (REQUIRED — the app refuses to start without one) ─────────
# Get one at https://openrouter.ai/keys
LLM_API_KEY=your-api-key-here

# Optional rotation pool. ANY var starting with OPENROUTER_API_KEY is
# auto-discovered and tried in sorted order when a key is rate-limited.
# OPENROUTER_API_KEY1=
# OPENROUTER_API_KEY2=

# Optional explicit model fallback chain, tried in sorted order.
# OPENROUTER_MODEL_1=qwen/qwen3-30b-a3b:free
# OPENROUTER_MODEL_2=openai/gpt-oss-20b:free

# ── Generation parameters ─────────────────────────────────────────────
LLM_MAX_TOKENS=3000
LLM_TEMPERATURE=0.3
# Caps the retry fan-out across keys/models for a single question.
LLM_MAX_KEYS_PER_MODEL=6
LLM_REQUEST_BUDGET_SECONDS=45

# ── Retrieval models ──────────────────────────────────────────────────
# Dense embeddings run locally in BOTH environments via fastembed/onnxruntime
# (no torch) — small enough for the free plan.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Cross-encoder re-ranker. Needs torch + sentence-transformers (see
# requirements-local.txt) and ~500MB extra RAM, so it is ON locally and
# OFF on Render. Defaults follow APP_ENV — only set this to override.
# CROSS_ENCODER_RERANK=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Server / CORS ─────────────────────────────────────────────────────
PORT=8000
# Comma-separated allowed frontend origins, no trailing slash.
# Local dev is served on 5500 by app.py. On Render, set your Vercel URL(s).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Logging ───────────────────────────────────────────────────────────
KB_LOG_LEVEL=INFO

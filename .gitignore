# ── Cricket World Cup RAG Assistant — repo-wide ignores ───────────────

# Secrets — never commit real environment files. `.env.example` IS tracked.
.env
.env.local
.env.*.local
backend/.env
frontend/.env
*.key
*.pem
secrets.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
.python-version

# Virtual environments
.venv/
venv/
env/
venv3/

# Node / Vercel
node_modules/
.vercel/
.next/

# Build artifacts
build/
dist/
pip-wheel-metadata/
wheelhouse/

# Model caches (downloaded at runtime / build time)
.hf-cache/
.fastembed-cache/
backend/.hf-cache/
backend/.fastembed-cache/

# Runtime output
backend/history.txt
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/

# IDEs / OS
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
~$*

# Misc
*.sqlite
*.db

# Generated at build time: by frontend/build.mjs on Vercel, and by app.py locally.
frontend/js/config.js
